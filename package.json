{
  "name": "yolomarkflow",
  "version": "1.0.3",
  "description": "图像标注工具，支持 YOLO 与 COCO 导入导出，集成训练插件以完成模型训练",
  "author": "YoloMarkFlow Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/aaaazbwzbw/YoloMarkFlow.git"
  },
  "main": "electron/main.js",
  "scripts": {
    "vue-dev": "vite",
    "build": "vite build",
    "electron": "electron --js-flags=--expose-gc .",
    "dev": "concurrently \"npm run vue-dev\" \"npm run electron\"",
    "rebuild": "electron-rebuild -f -w sqlite3 -v 26.2.1",
    "postinstall": "electron-rebuild -f -w sqlite3 -v 26.2.1",
    "electron:build": "vite build && electron-builder --win --x64"
  },
  "dependencies": {
    "@arco-design/web-vue": "^2.57.0",
    "@element-plus/icons-vue": "^2.1.0",
    "adm-zip": "^0.5.16",
    "echarts": "^6.0.0",
    "element-plus": "^2.4.1",
    "fabric": "^5.3.0",
    "marked": "^16.4.1",
    "mousetrap": "^1.6.5",
    "sqlite3": "^5.1.7",
    "vue": "^3.3.4",
    "vue-router": "^4.2.4",
    "vue-virtual-scroll-grid": "^1.11.0",
    "vue3-virtual-scroll-list": "^0.2.1",
    "vue3-virtual-scroller": "^0.2.3"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^4.3.4",
    "concurrently": "^8.2.1",
    "electron": "^26.2.1",
    "electron-builder": "^24.6.4",
    "electron-icon-builder": "^2.0.1",
    "electron-rebuild": "^3.2.9",
    "vite": "^4.4.9",
    "wait-on": "^7.0.1"
  },
  "build": {
    "electronVersion": "26.2.1",
    "appId": "com.yolomarkflow.app",
    "productName": "YoloMarkFlow",
    "electronDownload": {
      "mirror": "https://npmmirror.com/mirrors/electron/"
    },
    "directories": {
      "output": "D:/temp-build-output"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "loading.html",
      "用户手册.md",
      "node_modules/sqlite3/**/*",
      "!**/*.{ts,map}",
      "!plugins/**/*",
      "!models/**/*"
    ],
    "asar": true,
    "asarUnpack": [
      "**/*.node",
      "node_modules/sqlite3/**/*"
    ],
    "extraFiles": [
      {
        "from": "models",
        "to": "model",
        "filter": ["**/*.pt"]
      }
    ],
    "npmRebuild": false,
    "buildDependenciesFromSource": false,
    "nodeGypRebuild": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icons/win/icon.ico",
      "requestedExecutionLevel": "asInvoker",
      "executableName": "YoloMarkFlow",
      "sign": null,
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "YoloMarkFlow",
      "installerIcon": "build/icons/win/icon.ico",
      "uninstallerIcon": "build/icons/win/icon.ico",
      "installerHeaderIcon": "build/icons/win/icon.ico",
      "deleteAppDataOnUninstall": false,
      "allowElevation": true,
      "warningsAsErrors": false,
      "runAfterFinish": false,
      "menuCategory": false,
      "include": "build/installer-hooks.nsh",
      "packElevateHelper": false
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icons/mac/icon.icns",
      "category": "public.app-category.productivity"
    }
  }
}
